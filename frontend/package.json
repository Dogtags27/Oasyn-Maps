{
  "name": "@oasyn/frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Oasyn Maps frontend (Person B): React app, visual system, Navigator / Lab / Watch / Landing, i18n, accessibility, privacy, safety UI.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "i18n:check": "tsx scripts/i18n-check.mjs",
    "lint:content": "tsx scripts/lint-content.mjs",
    "lint:nohardcode": "tsx scripts/lint-nohardcode.mjs",
    "check": "npm run typecheck && npm run lint:content && npm run lint:nohardcode && npm run i18n:check && npm run test"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/leaflet": "^1.9.15",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
