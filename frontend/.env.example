# Client mode: mock (fixtures + local sample seed) or live (calls the API).
VITE_API_MODE=mock

# Base URL of the backend API when VITE_API_MODE=live.
VITE_API_BASE=https://oasyn-maps.onrender.com

# CARTO now requires a (free) API key for basemap tiles — anonymous requests
# return a watermarked "API KEY REQUIRED" tile instead of an error. Get a key
# at https://carto.com/basemaps/apikey and paste it here.
VITE_CARTO_API_KEY=
