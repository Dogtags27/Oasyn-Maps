# Checkpoint 1: the plan channel is live. The client calls the real API; if the
# backend is unreachable the UI offers clearly badged sample mode (never silent).
# Set VITE_API_MODE=mock to force the sample seed (hour-1 behaviour).
VITE_API_MODE=live
VITE_API_BASE=https://oasyn-maps.onrender.com

# CARTO now requires a (free) API key for basemap tiles — anonymous requests
# return a watermarked "API KEY REQUIRED" tile instead of an error, which is
# why the map looks blank/broken. Get a free key at
# https://carto.com/basemaps/apikey and paste it below.
VITE_CARTO_API_KEY=cb1_4tuq_1_ae89af2a0674948ed60ff0a3
