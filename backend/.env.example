# Cloudflare R2 — snapshot storage. Copy to `.env` and fill in real values.
# `.env` is gitignored; this template is committed so the shape is documented.
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=oasyn-maps-graph

# Key within the bucket for the "latest good snapshot" pointer.
R2_LATEST_POINTER=snapshots/inner-metro/latest.json
